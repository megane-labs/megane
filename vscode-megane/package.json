{
  "name": "vscode-megane",
  "displayName": "Megane - Molecular Viewer",
  "description": "View and build molecular structure files (PDB, GRO, XYZ (incl. extended XYZ .extxyz and Jmol .jxyz), MOL, SDF, MOL2, CIF, mmCIF, LAMMPS data, AMBER prmtop, ASE traj, XTC, LAMMPS dump, DCD, AMBER NetCDF, VASP POSCAR/CONTCAR/XDATCAR, CML, Molden, XCrySDen XSF, Chem3D XML, Odyssey xodydata/odydata, CASTEP magres, GAMESS output, CASTEP phonon), volumetric grids (Gaussian CUBE, OpenDX), and JCAMP-DX spectra (.jdx, .jcamp) with Megane",
  "version": "0.18.0",
  "publisher": "hodakamori",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/megane-labs/megane.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace, Megane Builder ignores tool servers configured in the workspace's settings (megane.builder.mcpServers), since they run commands on your computer.",
      "restrictedConfigurations": [
        "megane.builder.mcpServers"
      ]
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "megane.structureViewer",
        "displayName": "Megane Molecular Viewer",
        "selector": [
          {
            "filenamePattern": "*.pdb"
          },
          {
            "filenamePattern": "*.gro"
          },
          {
            "filenamePattern": "*.xyz"
          },
          {
            "filenamePattern": "*.mol"
          },
          {
            "filenamePattern": "*.sdf"
          },
          {
            "filenamePattern": "*.mol2"
          },
          {
            "filenamePattern": "*.cif"
          },
          {
            "filenamePattern": "*.mmcif"
          },
          {
            "filenamePattern": "*.data"
          },
          {
            "filenamePattern": "*.lammps"
          },
          {
            "filenamePattern": "*.prmtop"
          },
          {
            "filenamePattern": "*.traj"
          },
          {
            "filenamePattern": "*.xtc"
          },
          {
            "filenamePattern": "*.lammpstrj"
          },
          {
            "filenamePattern": "*.dump"
          },
          {
            "filenamePattern": "*.trj"
          },
          {
            "filenamePattern": "*.dcd"
          },
          {
            "filenamePattern": "*.nc"
          },
          {
            "filenamePattern": "*.vasp"
          },
          {
            "filenamePattern": "POSCAR*"
          },
          {
            "filenamePattern": "CONTCAR*"
          },
          {
            "filenamePattern": "XDATCAR*"
          },
          {
            "filenamePattern": "*.jxyz"
          },
          {
            "filenamePattern": "*.extxyz"
          },
          {
            "filenamePattern": "*.molden"
          },
          {
            "filenamePattern": "*.cml"
          },
          {
            "filenamePattern": "*.xsf"
          },
          {
            "filenamePattern": "*.axsf"
          },
          {
            "filenamePattern": "*.cube"
          },
          {
            "filenamePattern": "*.cub"
          },
          {
            "filenamePattern": "*.dx"
          },
          {
            "filenamePattern": "*.c3xml"
          },
          {
            "filenamePattern": "*.xodydata"
          },
          {
            "filenamePattern": "*.odydata"
          },
          {
            "filenamePattern": "*.magres"
          },
          {
            "filenamePattern": "*.gamess"
          },
          {
            "filenamePattern": "*.phonon"
          },
          {
            "filenamePattern": "*.jdx"
          },
          {
            "filenamePattern": "*.jcamp"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "megane.pipelineViewer",
        "displayName": "Megane Pipeline Viewer",
        "selector": [
          {
            "filenamePattern": "*.megane.json"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "megane",
          "title": "Megane",
          "icon": "resources/megane.svg"
        }
      ]
    },
    "views": {
      "megane": [
        {
          "id": "megane.builderView",
          "name": "Builder",
          "icon": "resources/megane.svg",
          "contextualTitle": "Megane Builder"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "megane.builderView",
        "contents": "Build or edit a molecular structure with Megane Builder: add, delete and move atoms, draw bonds, build crystals and save as XYZ, PDB or MOL.\n[New Structure](command:megane.builder.new)\n[Open File in Builder…](command:megane.builder.open)\nTo edit a file from the Explorer, right-click it and choose \"Open in Megane Builder\"."
      }
    ],
    "commands": [
      {
        "command": "megane.builder.new",
        "title": "New Structure",
        "category": "Megane Builder",
        "icon": "$(add)"
      },
      {
        "command": "megane.builder.open",
        "title": "Open File in Builder…",
        "category": "Megane Builder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "megane.builder.openFile",
        "title": "Open in Megane Builder",
        "category": "Megane Builder",
        "icon": "$(tools)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "megane.builder.new",
          "when": "view == megane.builderView",
          "group": "navigation@1"
        },
        {
          "command": "megane.builder.open",
          "when": "view == megane.builderView",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "megane.builder.openFile",
          "when": "resourceExtname =~ /^\\.(pdb|gro|xyz|extxyz|jxyz|mol|sdf|mol2|cif|mmcif|data|lammps|lammpstrj|dump|trj|traj|vasp|molden|cml|xsf|axsf|c3xml|xodydata|odydata|magres|gamess|phonon)$/i || resourceFilename =~ /^(POSCAR|CONTCAR|XDATCAR)/",
          "group": "navigation@90"
        }
      ],
      "editor/title": [
        {
          "command": "megane.builder.openFile",
          "when": "activeCustomEditorId == megane.structureViewer",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Megane",
      "properties": {
        "megane.builder.mcpServers": {
          "type": "object",
          "default": {},
          "scope": "machine-overridable",
          "markdownDescription": "MCP tool servers for Megane Builder's **Tools** menu ([Builder Tool Contract](https://megane-labs.github.io/megane/dev/builder-tools)), in the `mcpServers` format LLM clients use. A stdio server is `{ \"command\": \"python\", \"args\": [\"my_tools.py\"] }` (optional `env`, `cwd`); a Streamable HTTP server is `{ \"url\": \"https://…/mcp\", \"headers\": { \"Authorization\": \"Bearer …\" } }` (https, or http on this machine). `${workspaceFolder}` and `${userHome}` are replaced. Megane asks before it first uses a server. Without a setting, the reference server `megane-builder-tools` (liquid box, polymer chain, solvate) is offered too: the `megane-builder-tools` command if it is installed, else run by `uvx` at the version Megane was tested with. An entry named `megane-builder-tools` replaces it; `\"megane-builder-tools\": null` hides it.",
          "additionalProperties": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "stdio",
                  "http",
                  "streamable-http"
                ],
                "description": "Optional: the transport, inferred from command or url."
              },
              "command": {
                "type": "string",
                "description": "The program that starts a stdio server."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments for command."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra environment variables for command."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for command (default: the first workspace folder)."
              },
              "url": {
                "type": "string",
                "description": "The Streamable HTTP endpoint of a server, e.g. http://127.0.0.1:8765/mcp."
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "HTTP headers, e.g. Authorization."
              }
            },
            "description": "A server (an object), or null to hide the default megane-builder-tools."
          }
        }
      }
    }
  },
  "scripts": {
    "build:webview": "vite build --config vite.webview.config.ts && vite build --config vite.builder.config.ts",
    "build:extension": "tsc -p tsconfig.json && node esbuild.extension.mjs",
    "build": "npm run build:webview && npm run build:extension",
    "watch": "node esbuild.extension.mjs --watch",
    "vscode:prepublish": "npm run build",
    "package": "vsce package"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/node": "^25.3.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.80.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vscode/vsce": "^3.9.2",
    "@xyflow/react": "^12.0.0",
    "esbuild": "^0.25.12",
    "gif.js": "^0.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.172.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.5",
    "vite-plugin-wasm": "^3.5.0",
    "zustand": "^5.0.0"
  }
}
