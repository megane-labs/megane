            "title": "Tail atom",
            "type": "integer",
            "x-megane-of": "monomer",
            "x-megane-widget": "atom"
          },
          "seed": {
            "description": "Random seed; the same seed gives the same result.",
            "minimum": 0,
            "title": "Seed",
            "type": "integer",
            "x-megane-widget": "seed"
